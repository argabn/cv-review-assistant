{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "reviewed",
        "request_clarification"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "corrected_facts": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "quote"
                ],
                "additionalProperties": false
              }
            },
            "education": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "degree": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "field": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "institution": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "degree",
                  "field",
                  "institution",
                  "quote"
                ],
                "additionalProperties": false
              }
            },
            "experience": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "organization": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "period_raw": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "role",
                  "organization",
                  "period_raw",
                  "description",
                  "quote"
                ],
                "additionalProperties": false
              }
            },
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "description",
                  "quote"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "skills",
            "education",
            "experience",
            "projects"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reviewer",
    "candidate_id",
    "action",
    "notes",
    "corrected_facts"
  ],
  "additionalProperties": false
}