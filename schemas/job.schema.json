{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "enum": [
              "skills",
              "education",
              "experience",
              "projects"
            ]
          },
          "any_of": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "field",
          "any_of",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "title",
    "version",
    "criteria"
  ],
  "additionalProperties": false
}