{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "processing_status": {
      "enum": [
        "success",
        "failed"
      ]
    },
    "facts": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "degree": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "institution": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "degree",
              "field",
              "institution",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "organization": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "period_raw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "organization",
              "period_raw",
              "description",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "description",
              "quote"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "skills",
        "education",
        "experience",
        "projects"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "supported",
              "not_evidenced"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion_id",
          "label",
          "required",
          "status",
          "evidence",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ready_for_review",
            "needs_clarification",
            "unable_to_assess"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "follow_up_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "summary",
        "rationale",
        "caveats",
        "follow_up_questions"
      ],
      "additionalProperties": false
    },
    "human_review_required": {
      "const": true
    },
    "final_decision": {
      "type": "null"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "mock",
            "ollama",
            "human_corrected"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1
        },
        "job_sha256": {
          "type": "string",
          "minLength": 1
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "author",
        "mode",
        "model",
        "job_title",
        "job_version",
        "source_sha256",
        "job_sha256",
        "elapsed_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "source",
    "processing_status",
    "facts",
    "assessment",
    "recommendation",
    "human_review_required",
    "final_decision",
    "errors",
    "metadata"
  ],
  "additionalProperties": false
}